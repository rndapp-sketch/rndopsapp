// CD pipeline for rndopsapp → LIVE server (172.16.134.179).
// Tracked branch: production-backend-live. See JENKINS_CI_CD_PLAN.md §6.
//
// WHY A SEPARATE FILE FROM Jenkinsfile
// `Jenkinsfile` deploys to Testing and hardcodes Testing's paths, site and
// tmux-free systemd unit on THIS host. Promotion merges testing-backend into
// production-backend-live, which carries that file along — so a Live job
// reading plain `Jenkinsfile` would deploy Live using Testing's settings and
// restart Testing's bench. The Live jobs therefore use scriptPath
// `Jenkinsfile.live`.
//
// HOW IT DIFFERS IN SHAPE
// Testing's backend job checks out directly into the live bench app via
// customWorkspace. That is impossible here — the target is a different machine
// — so this job checks out only to read itself, and every deploy action runs
// over SSH against .179. Jenkins' own workspace is irrelevant to what ships.
//
// SSH KEY: read from disk rather than Jenkins' credential store. The key is
// mode 600 owned by rndadmin, which is the user Jenkins runs as, so anyone able
// to run a Jenkins job could read it either way — the credential store would
// add indirection without changing the posture. Documented, not accidental.

pipeline {
  agent any

  // No pollSCM. Promotion to Live is a deliberate act: merging
  // testing-backend -> production-backend-live via a reviewed PR is the
  // approval gate, and this job is triggered from that. Add a trigger only if
  // you want a merge to ship to Live with nobody watching.

  options {
    timestamps()
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '50'))
  }

  parameters {
    // One pipeline, many servers. Previously the environment block hardcoded
    // orion@172.16.134.179 and /home/orion/..., so deploying anywhere else meant
    // editing this file and promoting it through testing -> production. The
    // target is now chosen per build instead.
    //
    // Deliberately a choice, not free text: a typo in a hostname would point a
    // production deploy at the wrong machine.
    choice(
      name: 'TARGET',
      choices: ['prod-206', 'live-179'],
      description: 'Which server to deploy to. prod-206 = 172.16.131.206 (REAL PRODUCTION, pragati.iitg.ac.in). live-179 = 172.16.134.179.'
    )
    booleanParam(
      name: 'DISCARD_REMOTE_CHANGES',
      defaultValue: false,
      description: 'Deploy even if the Live checkout has uncommitted tracked changes. ' +
                   'They will be PERMANENTLY LOST. Leave unticked unless you have ' +
                   'checked what they are and decided they are disposable.'
    )
  }

  environment {
    // Only the branch is fixed here; everything host-specific comes from the
    // 'Resolve target' stage below, keyed off the TARGET parameter.
    BRANCH = 'production-backend-live'
  }

  stages {
    // Turns TARGET into the env vars every later stage uses. Keeping the table
    // here rather than in each job means the two jobs cannot drift apart, and
    // adding a third server is one map entry.
    stage('Resolve target') {
      steps {
        script {
          def targets = [
            'prod-206': [
              ssh_key     : '/home/rndadmin/deploy-config/ssh/jenkins_prod_deploy',
              live        : 'prornd@172.16.131.206',
              live_url    : 'http://172.16.131.206:8000',
              app_dir     : '/home/prornd/frappe-dev/prornd/apps/rndopsapp',
              bench_dir   : '/home/prornd/frappe-dev/prornd',
              bench       : '/home/prornd/.local/bin/bench',
              site        : 'prornd.local',
              restart     : 'tmux',
              tmux_session: 'frappe',
            ],
            'live-179': [
              ssh_key     : '/home/rndadmin/deploy-config/ssh/jenkins_live_deploy',
              live        : 'orion@172.16.134.179',
              live_url    : 'http://172.16.134.179:8000',
              app_dir     : '/home/orion/frappe-dev/prornd/apps/rndopsapp',
              bench_dir   : '/home/orion/frappe-dev/prornd',
              bench       : '/home/orion/.local/bin/bench',
              site        : 'prornd.local',
              restart     : 'systemd',
              tmux_session: '',
            ],
          ]
          def t = targets[params.TARGET]
          if (!t) { error("unknown TARGET '${params.TARGET}'") }
          // Assigned one by one, NOT with `t.each { k, v -> env[k.toUpperCase()] = v }`.
          // That form calls DefaultGroovyMethods.putAt, which Jenkins' script
          // sandbox rejects outright (RejectedAccessException), and the stage
          // dies before any later stage can read a single value. Setting
          // env.NAME directly is whitelisted. Verbose, but it works and it makes
          // every variable the pipeline relies on visible here.
          env.SSH_KEY      = t.ssh_key
          env.LIVE         = t.live
          env.LIVE_URL     = t.live_url
          env.APP_DIR      = t.app_dir
          env.BENCH_DIR    = t.bench_dir
          env.BENCH        = t.bench
          env.SITE         = t.site
          env.RESTART      = t.restart
          env.TMUX_SESSION = t.tmux_session
          echo "Target: ${params.TARGET}  ->  ${env.LIVE}  (restart via ${env.RESTART})"
          if (params.TARGET == 'prod-206') {
            echo "NOTE: this is REAL PRODUCTION, serving users at pragati.iitg.ac.in"
          }
        }
      }
    }

    stage('Preflight') {
      steps {
        sh '''#!/bin/bash
          set -euo pipefail
          SSH="ssh -i $SSH_KEY -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 $LIVE"

          $SSH "test -d '$APP_DIR/.git'" || { echo "FATAL: $APP_DIR is not a git repo on Live"; exit 1; }
          $SSH "test -x '$BENCH'"        || { echo "FATAL: $BENCH missing on Live"; exit 1; }
          $SSH "test -d '$BENCH_DIR/sites/$SITE'" || { echo "FATAL: site $SITE not found on Live"; exit 1; }

          echo "Live host: $($SSH 'hostname; uptime -p')"

          # The checkout below would silently destroy local edits. Live had 12
          # such files when this pipeline was built, so this is a real risk.
          #
          # But "dirty" alone is the wrong test. A file edited on Live and then
          # committed upstream still shows as modified until Live's HEAD moves,
          # even though the deploy would write back identical bytes. Blocking on
          # that is a false alarm, and false alarms train people to tick the
          # override reflexively, which defeats the guard. So compare each
          # modified file against the commit being deployed, and only block on
          # ones that genuinely differ.
          $SSH "cd '$APP_DIR' && git fetch --no-tags -q origin '$BRANCH'"

          report=$($SSH "cd '$APP_DIR' && for f in \\$(git status --porcelain | grep '^ M' | awk '{print \\$2}'); do
                           if git diff --quiet FETCH_HEAD -- \\"\\$f\\" 2>/dev/null; then
                             echo \\"SAME \\$f\\"
                           else
                             echo \\"DIFF \\$f\\"
                           fi
                         done" || true)

          same=$(printf '%s\\n' "$report" | grep -c '^SAME ' || true)
          diff=$(printf '%s\\n' "$report" | grep -c '^DIFF ' || true)
          echo "uncommitted on Live: ${same:-0} already identical to $BRANCH, ${diff:-0} genuinely different"

          if [ "${same:-0}" -gt 0 ]; then
            printf '%s\\n' "$report" | grep '^SAME ' | sed 's/^SAME /  identical, will be rewritten unchanged: /'
          fi

          if [ "${diff:-0}" -gt 0 ]; then
            printf '%s\\n' "$report" | grep '^DIFF ' | sed 's/^DIFF /  UNIQUE TO LIVE: /'
            if [ "$DISCARD_REMOTE_CHANGES" != "true" ]; then
              echo ""
              echo "FATAL: the files above exist only on Live and are not in $BRANCH."
              echo "Deploying would destroy them. Commit them, copy them off, or"
              echo "re-run with DISCARD_REMOTE_CHANGES ticked to discard them."
              exit 1
            fi
            echo "WARNING: DISCARD_REMOTE_CHANGES is set — the files above will be LOST."
          fi
        '''
      }
    }

    // Explicit, before migrate touches the schema. bench migrate takes its own
    // backup, but the newest backup on Live was over two months old when this
    // was written, so do not rely on that alone.
    stage('Backup Live database') {
      steps {
        sh '''#!/bin/bash
          set -euo pipefail
          SSH="ssh -i $SSH_KEY -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 $LIVE"
          $SSH "cd '$BENCH_DIR' && '$BENCH' --site '$SITE' backup" 2>&1 | tail -5
          echo "newest backups now on Live:"
          $SSH "ls -t '$BENCH_DIR/sites/$SITE/private/backups' | head -3" | sed 's/^/  /'
        '''
      }
    }

    stage('Deploy code') {
      steps {
        sh '''#!/bin/bash
          set -euo pipefail
          SSH="ssh -i $SSH_KEY -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 $LIVE"

          before=$($SSH "cd '$APP_DIR' && git rev-parse --short HEAD")

          # Fetch only the branch we deploy, then move to exactly its remote
          # tip. Forced: no merge commits, no surprises from a diverged local
          # branch.
          #
          # The -f matters. Without it git refuses to switch while any tracked
          # file is modified - and it compares against HEAD, not against the
          # target, so even a file whose content already equals the target
          # blocks the switch ("Please commit your changes or stash them").
          # Preflight above has already decided whether proceeding is safe, so
          # discarding here is the decision being carried out rather than a new
          # one. Anything precious was caught by Preflight.
          $SSH "cd '$APP_DIR' && git fetch --no-tags origin '$BRANCH' && git checkout -f -B '$BRANCH' FETCH_HEAD" 2>&1 | tail -3

          after=$($SSH "cd '$APP_DIR' && git rev-parse --short HEAD")
          echo "Live moved: $before -> $after"
          $SSH "cd '$APP_DIR' && git log -1 --format='  %h %an  %s'"
        '''
      }
    }

    stage('Migrate') {
      steps {
        sh '''#!/bin/bash
          set -euo pipefail
          SSH="ssh -i $SSH_KEY -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 $LIVE"
          $SSH "cd '$BENCH_DIR' && '$BENCH' --site '$SITE' migrate" 2>&1 | tail -25
        '''
      }
    }

    stage('Clear cache') {
      steps {
        sh '''#!/bin/bash
          set -euo pipefail
          SSH="ssh -i $SSH_KEY -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 $LIVE"
          $SSH "cd '$BENCH_DIR' && '$BENCH' --site '$SITE' clear-cache"
        '''
      }
    }

    // The gunicorn web process auto-reloads on .py changes, but the worker,
    // scheduler and kafka_consumer do not — they need a real restart.
    // XDG_RUNTIME_DIR must be exported: a non-login SSH session has no user bus
    // without it. /run/user/1000 persists only because lingering is enabled
    // for orion.
    stage('Restart bench') {
      steps {
        sh '''#!/bin/bash
          set -euo pipefail
          SSH="ssh -i $SSH_KEY -o BatchMode=yes -o StrictHostKeyChecking=no -o ConnectTimeout=10 $LIVE"

          # gunicorn runs with --reload so it picks up .py changes itself, but the
          # worker, scheduler and kafka consumer do not - they need a real restart.
          # How to do that differs per server, hence RESTART.
          case "$RESTART" in
            systemd)
              $SSH 'export XDG_RUNTIME_DIR=/run/user/$(id -u); systemctl --user cat frappe-bench.service >/dev/null 2>&1' \
                || { echo "FATAL: frappe-bench.service not found on $LIVE"; exit 1; }
              $SSH 'export XDG_RUNTIME_DIR=/run/user/$(id -u); systemctl --user restart frappe-bench && systemctl --user is-active frappe-bench'
              ;;
            tmux)
              # This host runs bench by hand in a tmux session (honcho + Procfile),
              # with no systemd unit and no lingering. Ctrl-C the session and
              # restart in place - deliberately matching what is already there
              # rather than changing how production is supervised. Consequence:
              # nothing here survives a reboot.
              $SSH "tmux has-session -t '$TMUX_SESSION' 2>/dev/null" \
                || { echo "FATAL: tmux session '$TMUX_SESSION' not found on $LIVE"; exit 1; }
              $SSH "tmux send-keys -t '$TMUX_SESSION' C-c"
              for i in $(seq 1 30); do
                $SSH "ss -tln | grep -q ':8000 '" || break
                sleep 1
              done
              if $SSH "ss -tln | grep -q ':8000 '"; then
                echo "FATAL: port 8000 still held after Ctrl-C to '$TMUX_SESSION'"
                exit 1
              fi
              $SSH "tmux send-keys -t '$TMUX_SESSION' 'cd $BENCH_DIR && bench start' Enter"
              ;;
            *)
              echo "FATAL: unknown RESTART method '$RESTART'"; exit 1 ;;
          esac
        '''
      }
    }

    stage('Wait for Live') {
      steps {
        sh '''#!/bin/bash
          set -euo pipefail
          for i in $(seq 1 45); do
            if curl -fsS "$LIVE_URL/api/method/ping" 2>/dev/null | grep -q pong; then
              echo "OK: Live responded after $((i * 2))s"
              exit 0
            fi
            sleep 2
          done
          echo "FATAL: Live did not answer $LIVE_URL/api/method/ping within 90s"
          echo "Logs: ssh $LIVE 'export XDG_RUNTIME_DIR=/run/user/\\$(id -u); journalctl --user -u frappe-bench -n 50 --no-pager'"
          exit 1
        '''
      }
    }

    stage('Smoke test') {
      steps {
        sh '''#!/bin/bash
          set -euo pipefail
          ping=$(curl -fsS "$LIVE_URL/api/method/ping")
          printf '%s' "$ping" | grep -q pong || { echo "FATAL: ping returned: $ping"; exit 1; }

          # /app must redirect rather than 500 — catches a site that boots the
          # web process but fails on app/doctype import.
          app=$(curl -s -o /dev/null -w '%{http_code}' "$LIVE_URL/app")
          case "$app" in
            2*|3*) ;;
            *) echo "FATAL: /app returned HTTP $app"; exit 1 ;;
          esac
          echo "OK: ping=pong, /app=$app"
        '''
      }
    }
  }

  post {
    success { echo "Deployed production-backend-live to 172.16.134.179" }
    failure {
      echo "LIVE DEPLOY FAILED — 172.16.134.179 may be mid-restart or down."
      echo "Check:  ssh ${env.LIVE ?: '<target>'}"
      echo "        export XDG_RUNTIME_DIR=/run/user/\$(id -u)"
      echo "        systemctl --user status frappe-bench"
      echo "        journalctl --user -u frappe-bench -n 80 --no-pager"
      echo "Backups: ${env.BENCH_DIR ?: '<bench>'}/sites/${env.SITE ?: '<site>'}/private/backups"
    }
  }
}
